<Window x:Class="AromaDom.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Арома Дом"
        Style="{StaticResource AppWindow}"
        Height="650" Width="950" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,15">
            <Button DockPanel.Dock="Right" Content="Добавить материал"
            VerticalAlignment="Center" Click="AddButton_Click"/>
            <TextBlock Text="Материалы" FontSize="26" FontWeight="Bold"
               VerticalAlignment="Center"
               Foreground="{StaticResource AccentBrush}"/>
        </DockPanel>

        <ListBox x:Name="MaterialsListBox" Grid.Row="1"
                 BorderThickness="0"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionChanged="MaterialsListBox_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource SecondaryBackground}"
                            CornerRadius="6" Padding="15" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock FontSize="13" Text="{Binding MaterialType}"/>
                                <TextBlock FontSize="18" FontWeight="Bold"
                                           Text="{Binding MaterialName}" Margin="0,2,0,6"/>
                                <TextBlock Text="{Binding MinimumText}"/>
                                <TextBlock Text="{Binding StockText}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding PriceText}" FontWeight="Bold" TextAlignment="Right"/>
                                <TextBlock Text="{Binding RequiredText}" Margin="0,6,0,0" TextAlignment="Right"/>
                                <Button Content="Продукция" Margin="0,10,0,0" Padding="12,6" HorizontalAlignment="Right" Click="ProductsButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
