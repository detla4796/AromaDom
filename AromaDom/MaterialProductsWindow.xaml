<Window x:Class="AromaDom.MaterialProductsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AromaDom"
        mc:Ignorable="d"
        Title="Арома Дом" 
        Style="{StaticResource AppWindow}"
        Width="650" Height="550" MinWidth="500"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Продукция, в которой используется материал" FontSize="13"/>
            <TextBlock x:Name="MaterialNameTextBlock" FontSize="24" FontWeight="Bold" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}"/>
        </StackPanel>

        <ListBox x:Name="ProductsListBox" Grid.Row="1" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource SecondaryBackground}" CornerRadius="6" Padding="15" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock FontSize="18" FontWeight="Bold" TextWrapping="Wrap" Text="{Binding ProductName}"/>
                                <TextBlock FontSize="13" Margin="0,4,0,0" Text="{Binding ArticleText}"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="15,0,0,0" Text="{Binding QuantityText}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="EmptyTextBlock" Grid.Row="1" Text="Этот материал пока не используется ни в одной рецептуре." TextWrapping="Wrap" FontSize="15" Visibility="Collapsed"/>

        <Button Grid.Row="2" Content="Назад" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Margin="0,15,0,0" Click="BackButton_Click"/>
    </Grid>
</Window>
